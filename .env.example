# Model. DataClaw uses .pi/settings.json, then ~/.pi/agent/settings.json,
# and the matching credential in ~/.pi/agent/auth.json. These override that choice.
# DEFAULT_MODEL_PROVIDER=opencode-go
# DEFAULT_MODEL_ID=deepseek-v4.1-flash
# OPENCODE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Databricks managed SQL MCP (https://<workspace>/api/2.0/mcp/sql)
# Leave DATABRICKS_TOKEN unset to use the Databricks CLI profile's OAuth token.
DATABRICKS_HOST=https://dbc-0000000000000000.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_PROFILE=DEFAULT
# DATABRICKS_WAREHOUSE_ID=
# DATABRICKS_MCP_URL=https://<workspace>/api/2.0/mcp/sql
# DATABRICKS_MCP_TIMEOUT_MS=120000
# Attach Databricks automatically when the CLI/harness boots
# DATABRICKS_AUTO_CONNECT=true
