{
  "name": "dataclaw",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/console/api/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "console": "bun run src/console/api/server.ts",
    "cli": "bun run src/cli.ts",
    "demo": "bun run examples/demo-run.ts",
    "demo:auto-improve": "bun run examples/auto-improve-demo.ts",
    "demo:resilience": "bun run examples/crash-resilience-demo.ts",
    "demo:databricks": "bun run examples/databricks-demo.ts",
    "evals": "bun run evals/run.ts",
    "evals:report": "bun run evals/report.ts",
    "evals:calibrate": "bun run evals/calibrate.ts",
    "evals:compare": "bun run evals/compare.ts",
    "evals:power": "bun run evals/power.ts",
    "evals:growth": "bun run evals/growth-funnel.ts",
    "showcase": "bun run examples/most-impressive-project.ts",
    "mip": "bun run examples/most-impressive-project.ts",
    "plugins:list": "bun run src/plugins/cli.ts",
    "dab:validate": "databricks bundle validate -t dev --profile dev",
    "dab:deploy": "databricks apps deploy -t dev --profile dev",
    "dab:logs": "databricks apps logs dataclaw --profile dev",
    "vps:start": "HOST=0.0.0.0 NODE_ENV=production bun run src/console/api/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  }
}
