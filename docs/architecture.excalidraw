      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why SQLite WAL vs Postgres?\nInstantaneous local atomic commits (<1ms), zero operational overhead for ephemeral sandbox containers, and deterministic resumption from disk via harness.resume().",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
