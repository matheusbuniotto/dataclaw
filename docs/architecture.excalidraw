      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why Clustered Bootstrap?\nRepeated runs on the same task have ICC = 0.15. Treating them as independent underestimates variance by 1.6x, producing false-positive ship decisions.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 11
